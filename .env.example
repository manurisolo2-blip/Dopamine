# ===================================================================
# DOPAMINE LUXURY STREETWEAR — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your production credentials.
# ===================================================================

# -------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# -------------------------------------------------------------------
# 2. DATABASE PERSISTENCE MODE & CONNECTION
# -------------------------------------------------------------------
# Persistence options: 'supabase' | 'json_file' | 'mysql'
DB_TYPE=json_file

# Supabase PostgreSQL (Required if DB_TYPE=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Optional Legacy MySQL Connection (Required if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dopamine_db

# -------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS
# -------------------------------------------------------------------
# Secret key used to sign and verify customer/admin JWT session tokens
JWT_SECRET=dopamine_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Master Admin authorization token for protected /api/admin/* endpoints
ADMIN_SECRET=dopamine_admin_master_secret_2026

# -------------------------------------------------------------------
# 4. MERCADO PAGO CHECKOUT PRO & WEBHOOKS
# -------------------------------------------------------------------
# Mercado Pago Access Token (Test: TEST-..., Production: APP_USR-...)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Mercado Pago Public Key (Client SDK integration)
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Secret key for validating Mercado Pago x-signature HMAC webhook headers
MP_WEBHOOK_SECRET=your_mercadopago_webhook_signing_secret

# -------------------------------------------------------------------
# 5. NODEMAILER / SMTP NOTIFICATIONS & OTP VERIFICATION
# -------------------------------------------------------------------
EMAIL_USER=soporte.dopaminestreetwear@gmail.com
EMAIL_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# -------------------------------------------------------------------
# 6. E-COMMERCE BUSINESS CONSTANTS
# -------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=90000
TRANSFER_DISCOUNT_PERCENT=10
DEFAULT_CURRENCY=ARS
